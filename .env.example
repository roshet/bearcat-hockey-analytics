# --- Database ---
# Local dev Postgres (see docker-compose.yml)
BCA_DATABASE_URL=postgresql+psycopg://bca:bca@localhost:5433/bca

# --- ACHA / HockeyTech LeagueStat feed ---
# The key achahockey.org's own pages send to the feed. REQUIRED; not committed.
BCA_ACHA_CLIENT_CODE=acha
BCA_ACHA_API_KEY=

# Politeness. Do not lower the delay without a good reason.
BCA_REQUEST_DELAY_SECONDS=1.0
BCA_REQUEST_TIMEOUT_SECONDS=30
BCA_MAX_RETRIES=4

# Identify ourselves honestly, with a way to be contacted.
# REQUIRED. Ingestion refuses to run until this is a real address -- it goes
# into the User-Agent on every request and is how the ACHA reaches you.
BCA_CONTACT_EMAIL=you@example.com

# On-disk HTTP cache (keeps backfills from re-fetching during development)
BCA_CACHE_DIR=data/cache
BCA_CACHE_ENABLED=true
